# ─── Regrow — variables d'environnement (exemple) ───────────────────────────
# Copie ce fichier en `.env` et remplis les valeurs. NE JAMAIS committer `.env`.
#
# MODE MOCK : à true, l'app fonctionne SANS aucune clé (IA, achats, analytics
# simulés). Mets à false uniquement quand tu as configuré les services réels.
EXPO_PUBLIC_MOCK_MODE=true

# ─── Supabase (auth anonyme, Postgres, storage chiffré, région UE) ──────────
# Clés PUBLIQUES uniquement côté client (l'anon key est faite pour être
# embarquée dans l'app, la sécurité vient des règles RLS). Les clés
# service_role et API IA restent EXCLUSIVEMENT dans les Edge Functions
# (secrets Supabase).
# Projet Regrow : fukuweosjlnrouixzulb (UE).
EXPO_PUBLIC_SUPABASE_URL=https://fukuweosjlnrouixzulb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ1a3V3ZW9zamxucm91aXh6dWxiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQyOTk2MzksImV4cCI6MjA5OTg3NTYzOX0.mp-ZLmLJSlom4cI20py6yPg-xB5IgEDN74GrmepX7xE

# ─── RevenueCat (abonnements, mode sandbox en dev) ──────────────────────────
EXPO_PUBLIC_RC_IOS_KEY=

# ─── PostHog (analytics produit, aucune donnée personnelle) ─────────────────
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── EAS ────────────────────────────────────────────────────────────────────
EAS_PROJECT_ID=

# ─── Secrets Edge Functions (À DÉFINIR CÔTÉ SUPABASE, PAS ICI) ──────────────
# ANTHROPIC_API_KEY=...    (clé sk-ant-, uniquement en secret Supabase)
# ANTHROPIC_MODEL=claude-haiku-4-5   (déjà posé, changeable sans redéploiement)
# Ces valeurs ne doivent JAMAIS apparaître dans le bundle client.
